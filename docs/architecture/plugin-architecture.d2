direction: down

bookends: "Model Bookends" {
  style.fill: "#e0e0e0"
  style.stroke: "#9e9e9e"
  style.font-color: "#212121"
  direction: right

  EMB: "SpyreVocabParallelEmbedding\n(on-device gather; TP shard\nmask on CPU when TP>1)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  LM: "SpyreParallelLMHead\nx @ Wᵀ on Spyre; logits stay on\nSpyre for TP all_gather\n(TP≥1 vocab shard; pad to 64×32)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  LP: "SpyreLogitsProcessor\nD2H logits → CPU after head /\nTP all_gather (host-side sampling)" {
    style.fill: "#2e7d32"
    style.stroke: "#1b5e20"
    style.font-color: "#ffffff"
  }

  LM -> LP: "logits"
}

granite: "Granite Decoder Layer (× N)" {
  style.fill: "#e0e0e0"
  style.stroke: "#9e9e9e"
  style.font-color: "#212121"

  N1: "SpyreRMSNorm" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  QKV: "SpyreQKVParallelLinear (fused)\n1× x @ Wᵀ on Spyre;\nq,k,v split on-device" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  ROPE: "SpyreRotaryEmbedding\n(4D rotation cache primed pre-compile;\nindex_select + 2×2 rotation in-graph)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  ATTN: "SpyreAttentionImpl\n(mixed CPU+Spyre)" {
    style.fill: "#2e7d32"
    style.stroke: "#1b5e20"
    style.font-color: "#ffffff"
  }
  O_PROJ: "SpyreRowParallelLinear — o_proj\n(x @ Wᵀ on Spyre;\nall_reduce when TP>1)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  N2: "SpyreRMSNorm" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  GATE: "SpyreMergedColumnParallelLinear (fused)\n1× x @ Wᵀ on Spyre;\ngate,up split on-device" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  ACT: "SpyreSiluAndMul\nsilu(gate) * up on Spyre" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  DOWN: "SpyreRowParallelLinear — down_proj\n(x @ Wᵀ on Spyre;\nall_reduce when TP>1)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }

  N1 -> QKV -> ROPE -> ATTN -> O_PROJ
  O_PROJ -> N2: "+residual"
  N2 -> GATE -> ACT -> DOWN
}

attn_detail: "SpyreAttentionImpl Pipeline" {
  style.fill: "#e0e0e0"
  style.stroke: "#9e9e9e"
  style.font-color: "#212121"

  S1: "Bring q to CPU when its layout\ncan't be assembled on device\n(k/v stay on Spyre)" {
    style.fill: "#e65100"
    style.stroke: "#bf360c"
    style.font-color: "#ffffff"
  }
  S2: "Scatter new K/V into the cache\nvia a slot-major view\n(single index_copy_ per tensor) on Spyre" {
    style.fill: "#2e7d32"
    style.stroke: "#1b5e20"
    style.font-color: "#ffffff"
  }
  S3: "Per-sequence varlen loop\n(query_start_loc; pad query_len\nto its bucket)" {
    style.fill: "#e65100"
    style.stroke: "#bf360c"
    style.font-color: "#ffffff"
  }
  S4: "Online softmax over pages\nQ @ Kᵀ·scale → soft-cap? →\n+mask → softmax → @V\n(compiled per (num_blocks, padded_query_len))" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  S5: "Stage result on CPU,\nthen bulk-copy into\nSpyre output buffer" {
    style.fill: "#2e7d32"
    style.stroke: "#1b5e20"
    style.font-color: "#ffffff"
  }

  S1 -> S2 -> S3 -> S4 -> S5
}

encoder_attn: "SpyreEncoderAttentionImpl (no KV cache)" {
  style.fill: "#e0e0e0"
  style.stroke: "#9e9e9e"
  style.font-color: "#212121"

  E1: "Ragged→dense batch on CPU\n(per-seq slice/transpose/scatter;\npad L & D to 64-stick)" {
    style.fill: "#e65100"
    style.stroke: "#bf360c"
    style.font-color: "#ffffff"
  }
  E2: "Single batched padded SDPA on Spyre\nF.scaled_dot_product_attention\n(is_causal=False, additive mask, enable_gqa)" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  E3: "Scatter to CPU, then per-token\noverwrite back into Spyre output" {
    style.fill: "#2e7d32"
    style.stroke: "#1b5e20"
    style.font-color: "#ffffff"
  }

  E1 -> E2 -> E3
}

bookends.EMB -> granite: "hidden states"
granite -> bookends.LM: "final hidden"
granite.ATTN -> attn_detail: "detail" {style.stroke-dash: 3}
granite.ATTN -> encoder_attn: "encoder-only models\nuse this impl instead" {style.stroke-dash: 3}

legend: " " {
  style.fill: "#e0e0e0"
  style.stroke: "#9e9e9e"
  style.font-color: "#212121"
  direction: right

  L1: "Spyre device" {
    style.fill: "#1565c0"
    style.stroke: "#0d47a1"
    style.font-color: "#ffffff"
  }
  L2: "CPU fallback" {
    style.fill: "#e65100"
    style.stroke: "#bf360c"
    style.font-color: "#ffffff"
  }
  L3: "Mixed CPU + Spyre" {
    style.fill: "#2e7d32"
    style.stroke: "#1b5e20"
    style.font-color: "#ffffff"
  }
}
